<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aplikasi Inventori & Penjualan Baru</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            margin: 0;
            padding: 20px;
            background: linear-gradient(135deg, #74ebd5, #acb6e5);
            color: #333;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            background-color: #fff;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
        }
        .header {
            text-align: center;
            padding: 20px;
            background-color: #ff6f61;
            color: white;
            border-radius: 10px 10px 0 0;
            margin: -30px -30px 20px -30px;
        }
        .header h1 {
            margin: 0;
            font-size: 28px;
        }
        .section {
            margin-bottom: 30px;
            padding: 20px;
            background-color: #f9f9f9;
            border-radius: 10px;
            border: 1px solid #ddd;
        }
        .section h2 {
            font-size: 20px;
            margin: 0 0 15px;
            color: #ff6f61;
            border-bottom: 2px solid #ff6f61;
            display: inline-block;
        }
        .form-group {
            margin-bottom: 20px;
        }
        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
            color: #555;
        }
        .form-group input, .form-group select {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 8px;
            box-sizing: border-box;
            font-size: 16px;
            background-color: #fff;
            transition: border-color 0.3s ease;
        }
        .form-group input:focus, .form-group select:focus {
            border-color: #ff6f61;
            outline: none;
        }
        .form-group button {
            background-color: #28a745;
            color: white;
            padding: 12px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            width: 100%;
            font-size: 16px;
            transition: background-color 0.3s ease;
        }
        .form-group button:hover {
            background-color: #218838;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            background-color: #fff;
        }
        table, th, td {
            border: 1px solid #ddd;
        }
        th, td {
            padding: 12px;
            text-align: left;
        }
        th {
            background-color: #ff6f61;
            color: white;
            font-weight: bold;
        }
        td {
            background-color: #fefefe;
        }
        .delete-btn {
            background-color: #dc3545;
            color: white;
            padding: 8px 12px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 14px;
            transition: background-color 0.3s ease;
        }
        .delete-btn:hover {
            background-color: #c82333;
        }
        .pagination {
            text-align: center;
            margin-top: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .pagination span {
            margin: 0 15px;
            font-weight: bold;
            color: #ff6f61;
        }
        .pagination button {
            background-color: #ff6f61;
            color: white;
            padding: 8px 15px;
            border: none;
            border-radius: 20px;
            cursor: pointer;
            margin: 0 5px;
            transition: background-color 0.3s ease;
        }
        .pagination button:hover {
            background-color: #e65b50;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header Section -->
        <div class="header">
            <h1>Aplikasi Inventori & Penjualan Baru</h1>
        </div>

        <!-- Tambah Produk Section -->
        <div class="section">
            <h2>Tambah Produk</h2>
            <div class="form-group">
                <label for="nama-produk">Nama Produk</label>
                <input type="text" id="nama-produk" placeholder="Nama Produk">
            </div>
            <div class="form-group">
                <label for="jumlah-stok">Jumlah Stok</label>
                <input type="number" id="jumlah-stok" placeholder="Jumlah Stok">
            </div>
            <div class="form-group">
                <label for="harga-unit">Harga per Unit</label>
                <input type="text" id="harga-unit" placeholder="Harga per Unit">
            </div>
            <div class="form-group">
                <button>Tambah Produk</button>
            </div>
        </div>

        <!-- Stok Produk Section -->
        <div class="section">
            <h2>Stok Produk</h2>
            <table>
                <tr>
                    <th>Nama</th>
                    <th>Stok</th>
                    <th>Harga</th>
                    <th>Aksi</th>
                </tr>
                <tr>
                    <td>Kopi</td>
                    <td>12</td>
                    <td>Rp 10.000</td>
                    <td><button class="delete-btn">Hapus</button></td>
                </tr>
                <tr>
                    <td>Susu</td>
                    <td>27</td>
                    <td>Rp 15.000</td>
                    <td><button class="delete-btn">Hapus</button></td>
                </tr>
                <tr>
                    <td>Roti</td>
                    <td>8</td>
                    <td>Rp 8.000</td>
                    <td><button class="delete-btn">Hapus</button></td>
                </tr>
            </table>
        </div>

        <!-- Penjualan Produk Section -->
        <div class="section">
            <h2>Penjualan Produk</h2>
            <div class="form-group">
                <label for="pilih-produk">Pilih Produk</label>
                <select id="pilih-produk">
                    <option>Kopi</option>
                    <option>Susu</option>
                    <option>Roti</option>
                </select>
            </div>
            <div class="form-group">
                <label for="jumlah-jual">Jumlah</label>
                <input type="number" id="jumlah-jual" placeholder="Jumlah">
            </div>
            <div class="form-group">
                <button>Jual</button>
            </div>
        </div>

        <!-- Daftar Penjualan Section -->
        <div class="section">
            <h2>Daftar Penjualan</h2>
            <table>
                <tr>
                    <th>Nama</th>
                    <th>Jumlah</th>
                    <th>Total Harga</th>
                </tr>
                <tr>
                    <td>Kopi</td>
                    <td>8</td>
                    <td>Rp 80.000</td>
                </tr>
                <tr>
                    <td>Roti</td>
                    <td>7</td>
                    <td>Rp 56.000</td>
                </tr>
                <tr>
                    <td>Susu</td>
                    <td>23</td>
                    <td>Rp 345.000</td>
                </tr>
            </table>
        </div>

        <!-- Pagination -->
        <div class="pagination">
            <button>-</button>
            <span>HALAMAN 1 / 7</span>
            <button>+</button>
        </div>
    </div>
</body>
</html>
